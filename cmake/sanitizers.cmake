# AXON_SANITIZE="address,undefined" or "thread". Applied per target by axon_apply_sanitizers.
set(AXON_SANITIZER_FLAGS "")
if(AXON_SANITIZE)
  string(REPLACE "," ";" _axon_san_list "${AXON_SANITIZE}")
  foreach(_san IN LISTS _axon_san_list)
    if(_san STREQUAL "address")
      list(APPEND AXON_SANITIZER_FLAGS -fsanitize=address -fno-omit-frame-pointer)
    elseif(_san STREQUAL "undefined")
      list(APPEND AXON_SANITIZER_FLAGS -fsanitize=undefined -fno-sanitize-recover=all)
    elseif(_san STREQUAL "thread")
      list(APPEND AXON_SANITIZER_FLAGS -fsanitize=thread)
    else()
      message(FATAL_ERROR "Unknown sanitizer '${_san}' in AXON_SANITIZE")
    endif()
  endforeach()
  if("address" IN_LIST _axon_san_list AND "thread" IN_LIST _axon_san_list)
    message(FATAL_ERROR "address and thread sanitizers cannot be combined")
  endif()
endif()

function(axon_apply_sanitizers target)
  if(AXON_SANITIZER_FLAGS)
    target_compile_options(${target} PRIVATE ${AXON_SANITIZER_FLAGS})
    target_link_options(${target} PRIVATE ${AXON_SANITIZER_FLAGS})
    target_compile_definitions(${target} PRIVATE AXON_SANITIZE_ENABLED=1)
  endif()
endfunction()
